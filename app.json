{
  "expo": {
    "name": "BumpToBliss",
    "slug": "BumpToBliss",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/brand/app-icon-cream-1024.png",
    "scheme": "bumptobliss",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./src/assets/brand/app-icon-cream-1024.png",
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F0E9E9",
        "foregroundImage": "./src/assets/brand/app-icon-cream-1024.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./src/assets/brand/app-icon-cream-1024.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/brand/splash-cream-1242x2688.png",
          "resizeMode": "cover",
          "backgroundColor": "#F0E9E9"
        }
      ],
      "@react-native-community/datetimepicker",
      "react-native-video",
      "expo-image",
      "expo-web-browser",
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
