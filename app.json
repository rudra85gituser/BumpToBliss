{
  "expo": {
    "name": "BumpToBliss",
    "slug": "BumpToBliss",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/app-logo/batman1.png",
    "scheme": "bumptobliss",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./src/assets/app-logo/batman1.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./src/assets/app-logo/batman1.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./src/assets/app-logo/batman1.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./src/assets/app-logo/batman1.png",
            "imageWidth": 76
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "react-native-video",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
